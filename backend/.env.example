# ==========================================================
# Orion Agro API — variáveis de ambiente
# Copie este arquivo para `.env` (na pasta backend/) e ajuste.
# ==========================================================

# URL pública do servidor (usada para montar texture_url da API)
PUBLIC_BASE_URL=http://localhost:8000

# Origens permitidas no CORS (lista JSON). Nunca use "*".
CORS_ORIGINS=["http://localhost:5501","http://127.0.0.1:5501","http://localhost:8000"]

# Banco de dados (SQLite por padrão)
DATABASE_URL=sqlite:///./agro_orion.db

# Aplicar migrações de esquema (PR #3 — ownership User -> Farm):
#   cd backend && alembic upgrade head
# Veja README ("Migrações / Alembic") e backend/alembic/.
# A aplicação aplica o Alembic no boot e falha explicitamente se a migration
# não puder ser concluída; não inicia com schema sem a FK física.

# NASA POWER — timeout da chamada e TTL do cache do endpoint LEGADO (minutos)
NASA_POWER_TIMEOUT_S=15
NASA_WEATHER_CACHE_MINUTES=60

# NASA POWER — serviço climático consolidado (PR #7 — /api/climate/farm/{id})
# Base da API (não altere em produção; mirror local apenas p/ testes de suporte):
#NASA_POWER_BASE_URL=https://power.larc.nasa.gov
# Defasagem NRT da fonte (dias) usada no fim dos presets 7d/15d/30d:
#NASA_POWER_NRT_LAG_DAYS=3
# Máximo de dias por período (janela personalizada):
#NASA_POWER_MAX_PERIOD_DAYS=366
# TTL (horas) do cache in-memory das séries diárias:
NASA_CLIMATE_CACHE_HOURS=6
# Baseline histórico: anos anteriores (mesma janela do calendário; máx. 10).
# Rotulado "referência histórica" — não é normal climatológica oficial (WMO/30a).
NASA_CLIMATE_BASELINE_YEARS=5
# Chuva "relevante" (mm/dia) p/ dias de chuva e sequência seca:
#NASA_CLIMATE_RAINY_DAY_THRESHOLD_MM=1.0
# Faixa ±% em torno da referência p/ classificar "próxima da referência":
#NASA_CLIMATE_BASELINE_BAND_PCT=20.0

# ------------------------------------------------------------
# SEGURANÇA (JWT) — OBRIGATÓRIO em produção
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Se vazio, um segredo EFÊMERO é usado (tokens expiram no restart).
# ------------------------------------------------------------
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=720

# RBAC — hierarquia de papéis (JSON; maior nível = mais privilégio).
# Padrão: user=1, produtor rural=1, operador de máquinas=1,
#         engenheiro agrônomo=1, admin=2 (nível máximo → acesso global).
# Papéis desconhecidos → nível de "user" (fail-closed).
#ROLE_HIERARCHY={"user":1,"produtor rural":1,"operador de máquinas":1,"engenheiro agrônomo":1,"admin":2}

# ------------------------------------------------------------
# COPERNICUS DEM GL-30 (topografia)
# As tiles GeoTIFF ficam em backend/data/dem/ (DEM_DIR).
# Sem tile, o 3D usa o deslocamento via NDVI (fallback) — a API
# responde available=false no endpoint /api/talhao/{id}/heightmap.
# ------------------------------------------------------------
DEM_DOWNLOAD_ENABLED=true
# Ajuste ao layout do espelho se necessário ({tile} = nome Copernicus):
# DEM_DOWNLOAD_URLS=["https://opentopography.s3.sdsc.edu/raster/COP30/DGED_2023_1/{tile}.tif"]
#DEM_DIR=backend/data/dem

# ------------------------------------------------------------
# COPERNICUS DATA SPACE ECOSYSTEM (CDSE) — SENTINEL-2 L2A REAL
# Crie um OAuth Client em https://dataspace.copernicus.eu (User Settings)
# e preencha. SEM credenciais o sistema NÃO quebra: usa o fallback
# procedural explícito e informa "DADOS SATELITAIS REAIS NÃO CONFIGURADOS".
# Os segredos NUNCA são versionados nem enviados ao frontend.
# ------------------------------------------------------------
CDSE_ENABLED=true
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
# Endpoints oficiais atuais (documentation.dataspace.copernicus.eu):
CDSE_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
CDSE_STAC_URL=https://stac.dataspace.copernicus.eu/v1
CDSE_PROCESS_URL=https://sh.dataspace.copernicus.eu/process/v1
# Seleção de cena:
CDSE_LOOKBACK_DAYS=60
CDSE_MAX_CLOUD_COVER=20
# Resiliência/performance:
CDSE_TIMEOUT_S=45
CDSE_CACHE_HOURS=12
CDSE_RETRY_ON_429=true
CDSE_RETRY_BACKOFF_S=2
CDSE_RASTER_SIZE=256

# Reverse geocoding (Nominatim OSM por padrão)
GEOCODER_URL=https://nominatim.openstreetmap.org/reverse
GEOCODER_USER_AGENT=OrionAgro/1.6 (contato-do-operador)
GEOCODER_TIMEOUT_S=8
GEOCODER_CACHE_HOURS=168
